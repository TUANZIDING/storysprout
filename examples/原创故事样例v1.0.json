  "sources": [
    {
      "id": "s01",
      "kind": "original",
      "language": "zh-CN",
      "locator": "原创短故事第1段",
      "text": "小熊豆豆戴着一顶红帽子，和小兔米米到公园玩。",
      "verificationStatus": "authorCreated"
    },
    {
      "id": "s02",
      "kind": "original",
      "language": "zh-CN",
      "locator": "原创短故事第2段",
      "text": "一阵风吹来，帽子飞走了。路旁有一个绿色盒子和一块灰色石头。",
      "verificationStatus": "authorCreated"
    },
    {
      "id": "s03",
      "kind": "original",
      "language": "zh-CN",
      "locator": "原创短故事第3段",
      "text": "米米指着绿色盒子问，这是不是豆豆的帽子。豆豆摇摇头，说那是盒子。",
      "verificationStatus": "authorCreated"
    },
    {
      "id": "s04",
      "kind": "original",
      "language": "zh-CN",
      "locator": "原创短故事第4段",
      "text": "米米看见红帽子挂在一根很低的树枝上。她站在地上就把帽子拿了下来，递给豆豆。",
      "verificationStatus": "authorCreated"
    },
    {
      "id": "s05",
      "kind": "original",
      "language": "zh-CN",
      "locator": "原创短故事第5段",
      "text": "豆豆说谢谢，两个朋友开心地笑了。他们发现帽檐上还坐着一只小瓢虫。",
      "verificationStatus": "authorCreated"
    }
  ],
